{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Dependency update policy, see CONTRIBUTING.md",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "timezone": "Europe/Paris",
  "schedule": ["before 9am on monday"],
  "postUpdateOptions": ["gomodTidy"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "labels": ["security"]
  },
  "packageRules": [
    {
      "description": "Group non-major Go module updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Go modules"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group base image updates",
      "matchDatasources": ["docker"],
      "matchDepNames": ["gcr.io/distroless/{/,}**"],
      "groupName": "Base image"
    },
    {
      "description": "Keep the Go toolchain in sync in go.mod, the Dockerfile and .tool-versions",
      "matchDepNames": ["go", "golang"],
      "groupName": "Go toolchain"
    },
    {
      "description": "Keep the go directive on the oldest supported Go release, it is raised by hand",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "enabled": false
    }
  ]
}
